{
  "name": "@kumo-shadcn/registry",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The generator and registry tooling: fetches Kumo, writes registry.json and registry/kumo/ at the repository root, builds public/r, and checks them.",
  "scripts": {
    "fetch-kumo": "src/fetch-kumo.sh ../../.kumo",
    "generate": "node src/generate.ts --kumo ../../.kumo",
    "build": "cd ../.. && shadcn build",
    "typecheck": "tsc -p tsconfig.registry.json && tsc -p tsconfig.json",
    "check-icons": "node src/check-icons.ts",
    "check-directory": "node src/check-directory.ts",
    "compare-themes": "node src/compare-themes.ts"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@phosphor-icons/react": "2.1.10",
    "@remixicon/react": "4.9.0",
    "@tabler/icons-react": "3.50.0",
    "@types/d3-geo": "3.1.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cn": "0.5.2",
    "d3-geo": "3.1.1",
    "echarts": "6.0.0",
    "lucide-react": "1.69.0",
    "motion": "12.38.0",
    "postcss": "8.5.32",
    "postcss-nested": "9.0.1",
    "react": "19.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  }
}
