{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "kumo-binding",
  "title": "Kumo binding to your shadcn theme",
  "description": "Sets Kumo's color tokens from your shadcn CSS variables (--background, --foreground, --primary, ...), so Kumo components follow your theme. Needs tailwind.cssVariables: true in components.json (with false there are no shadcn variables to read). Install one theme item: kumo-theme, kumo-cloudflare or kumo-binding.",
  "registryDependencies": [
    "https://raw.githubusercontent.com/tom-ricci/kumo-shadcn/main/public/r/kumo-base.json"
  ],
  "css": {
    "@layer base": {
      ":root": {
        "--success": "var(--color-emerald-600, oklch(59.6% 0.145 163.225))",
        "--warning": "oklch(73.9% 0.177 58.2)",
        "--info": "var(--color-blue-500, oklch(68.5% 0.169 237.323))",
        "--kumo-arrow-edge": "var(--border)",
        "--kumo-arrow-stroke": "transparent",
        "--kumo-badge-blue": "var(--color-blue-600, oklch(54.6% 0.245 262.881))",
        "--kumo-badge-green": "var(\n      --color-emerald-600,\n      oklch(59.6% 0.145 163.225)\n    )",
        "--kumo-badge-inverted": "var(--foreground)",
        "--kumo-badge-neutral": "var(--muted-foreground)",
        "--kumo-badge-orange": "var(--color-orange-650, oklch(81.5% 0.197 76))",
        "--kumo-badge-purple": "var(\n      --color-purple-600,\n      oklch(55.8% 0.288 302.321)\n    )",
        "--kumo-badge-red": "var(--color-red-600, oklch(57.7% 0.245 27.325))",
        "--kumo-badge-teal": "var(--color-teal-650, oklch(54.9% 0.096 184.565))",
        "--kumo-banner-info": "color-mix(in oklab, var(--info) 12%, transparent)",
        "--kumo-banner-warning": "color-mix(in oklab, var(--warning) 9%, transparent)",
        "--kumo-base": "var(--card)",
        "--kumo-brand": "var(--primary)",
        "--kumo-brand-hover": "color-mix(in oklab, var(--kumo-brand), black 15%)",
        "--kumo-canvas": "color-mix(in oklab, var(--background), var(--foreground) 1.4%)",
        "--kumo-contrast": "var(--foreground)",
        "--kumo-control": "var(--background)",
        "--kumo-danger": "var(--destructive)",
        "--kumo-danger-tint": "color-mix(in oklab, var(--destructive) 5%, transparent)",
        "--kumo-elevated": "color-mix(in oklab, var(--background), var(--foreground) 2.2%)",
        "--kumo-fill": "color-mix(in oklab, var(--secondary), var(--secondary-foreground) 6%)",
        "--kumo-fill-hover": "var(--accent)",
        "--kumo-focus": "var(--ring)",
        "--kumo-hairline": "color-mix(in oklab, var(--border), var(--background) 25%)",
        "--kumo-info": "var(--info)",
        "--kumo-info-tint": "color-mix(in oklab, var(--info) 7%, transparent)",
        "--kumo-interact": "color-mix(in oklab, var(--accent), var(--accent-foreground) 13%)",
        "--kumo-line": "var(--border)",
        "--kumo-overlay": "color-mix(in oklab, var(--popover), var(--popover-foreground) 1.4%)",
        "--kumo-recessed": "color-mix(in oklab, var(--background), var(--foreground) 4%)",
        "--kumo-shadow-drop": "oklch(0% 0 0 / 0.08)",
        "--kumo-shadow-edge": "oklch(0% 0 0 / 0.12)",
        "--kumo-success": "var(--success)",
        "--kumo-success-tint": "color-mix(in oklab, var(--success) 5%, transparent)",
        "--kumo-tint": "var(--muted)",
        "--kumo-warning": "var(--warning)",
        "--kumo-warning-tint": "color-mix(in oklab, var(--warning) 7%, transparent)",
        "--kumo-text-badge-inverted": "var(--background)",
        "--kumo-text-badge-neutral-subtle": "color-mix(in oklab, var(--foreground), var(--background) 15%)",
        "--kumo-text-badge-orange-subtle": "var(\n      --color-orange-800,\n      oklch(47% 0.157 37.304)\n    )",
        "--kumo-text-badge-teal-subtle": "var(\n      --color-teal-800,\n      oklch(43.7% 0.078 188.216)\n    )",
        "--kumo-text-brand": "#f6821f",
        "--kumo-text-danger": "color-mix(in oklab, var(--destructive), black 15%)",
        "--kumo-text-default": "color-mix(in oklab, var(--foreground), var(--background) 6%)",
        "--kumo-text-inactive": "color-mix(in oklab, var(--muted-foreground), var(--background) 70%)",
        "--kumo-text-info": "color-mix(in oklab, var(--info), black 31%)",
        "--kumo-text-inverse": "color-mix(in oklab, var(--background), var(--foreground) 3%)",
        "--kumo-text-link": "color-mix(in oklab, var(--info), black 31%)",
        "--kumo-text-placeholder": "color-mix(in oklab, var(--muted-foreground), var(--background) 35%)",
        "--kumo-text-strong": "var(--foreground)",
        "--kumo-text-subtle": "var(--muted-foreground)",
        "--kumo-text-success": "color-mix(in oklab, var(--success), black 28%)",
        "--kumo-text-warning": "color-mix(in oklab, var(--warning), black 20%)"
      },
      ".dark": {
        "--success": "var(--color-emerald-400, oklch(76.5% 0.177 163.223))",
        "--warning": "oklch(64.5% 0.168 50)",
        "--info": "var(--color-blue-500, oklch(68.5% 0.169 237.323))",
        "--kumo-arrow-edge": "transparent",
        "--kumo-arrow-stroke": "var(--kumo-line)",
        "--kumo-badge-blue": "var(--color-blue-700, oklch(48.8% 0.243 264.376))",
        "--kumo-badge-green": "var(\n      --color-emerald-700,\n      oklch(50.8% 0.118 165.612)\n    )",
        "--kumo-badge-inverted": "var(--foreground)",
        "--kumo-badge-neutral": "color-mix(in oklab, var(--muted-foreground), var(--background) 48%)",
        "--kumo-badge-orange": "var(--color-orange-650, oklch(81.5% 0.197 76))",
        "--kumo-badge-purple": "var(\n      --color-purple-700,\n      oklch(49.6% 0.265 301.924)\n    )",
        "--kumo-badge-red": "var(--color-red-700, oklch(50.5% 0.213 27.518))",
        "--kumo-badge-teal": "var(--color-teal-700, oklch(51.1% 0.096 186.391))",
        "--kumo-banner-info": "color-mix(in oklab, var(--info) 21%, transparent)",
        "--kumo-banner-warning": "color-mix(in oklab, var(--warning) 40%, transparent)",
        "--kumo-base": "color-mix(in oklab, var(--card), var(--background) 50%)",
        "--kumo-brand": "var(--primary)",
        "--kumo-brand-hover": "color-mix(in oklab, var(--kumo-brand), black 8%)",
        "--kumo-canvas": "color-mix(in oklab, var(--background), black 35%)",
        "--kumo-contrast": "var(--foreground)",
        "--kumo-control": "var(--card)",
        "--kumo-danger": "var(--destructive)",
        "--kumo-danger-tint": "color-mix(in oklab, var(--destructive) 6%, transparent)",
        "--kumo-elevated": "color-mix(in oklab, var(--background), black 20%)",
        "--kumo-fill": "var(--secondary)",
        "--kumo-fill-hover": "var(--accent)",
        "--kumo-focus": "var(--ring)",
        "--kumo-hairline": "var(--border)",
        "--kumo-info": "var(--info)",
        "--kumo-info-tint": "color-mix(in oklab, var(--info) 9%, transparent)",
        "--kumo-interact": "color-mix(in oklab, var(--accent), var(--accent-foreground) 14%)",
        "--kumo-line": "color-mix(in oklab, var(--border), var(--foreground) 4%)",
        "--kumo-overlay": "color-mix(in oklab, var(--popover), var(--popover-foreground) 7%)",
        "--kumo-recessed": "var(--background)",
        "--kumo-shadow-drop": "oklch(0% 0 0 / 0.3)",
        "--kumo-shadow-edge": "oklch(100% 0 0 / 0.1)",
        "--kumo-success": "var(--success)",
        "--kumo-success-tint": "color-mix(in oklab, var(--success) 7%, transparent)",
        "--kumo-tint": "var(--muted)",
        "--kumo-warning": "var(--warning)",
        "--kumo-warning-tint": "color-mix(in oklab, var(--warning) 13%, transparent)",
        "--kumo-text-badge-inverted": "var(--background)",
        "--kumo-text-badge-neutral-subtle": "color-mix(in oklab, var(--foreground), var(--background) 8%)",
        "--kumo-text-badge-orange-subtle": "var(\n      --color-orange-200,\n      oklch(90.1% 0.076 70.697)\n    )",
        "--kumo-text-badge-teal-subtle": "var(\n      --color-teal-200,\n      oklch(91% 0.096 180.426)\n    )",
        "--kumo-text-brand": "#f6821f",
        "--kumo-text-danger": "var(--destructive)",
        "--kumo-text-default": "color-mix(in oklab, var(--foreground), var(--background) 2%)",
        "--kumo-text-inactive": "color-mix(in oklab, var(--muted-foreground), var(--background) 45%)",
        "--kumo-text-info": "color-mix(in oklab, var(--info), white 22%)",
        "--kumo-text-inverse": "color-mix(in oklab, var(--background), var(--foreground) 7%)",
        "--kumo-text-link": "color-mix(in oklab, var(--info), white 22%)",
        "--kumo-text-placeholder": "color-mix(in oklab, var(--muted-foreground), var(--background) 25%)",
        "--kumo-text-strong": "var(--foreground)",
        "--kumo-text-subtle": "var(--muted-foreground)",
        "--kumo-text-success": "color-mix(in oklab, var(--success), white 55%)",
        "--kumo-text-warning": "color-mix(in oklab, var(--warning), white 28%)"
      },
      "@supports (color: oklch(from red l c h))": {
        ":root": {
          "--kumo-brand": "oklch(from var(--primary) min(l, 0.6) c h)",
          "--kumo-danger": "oklch(from var(--destructive) min(l, 0.64) c h)"
        },
        ".dark": {
          "--kumo-brand": "oklch(from var(--primary) min(l, 0.6) c h)",
          "--kumo-danger": "oklch(from var(--destructive) min(l, 0.6) c h)"
        }
      }
    }
  },
  "docs": "Use one Kumo theme item at a time. To switch, delete the previous theme's rules from @layer base in your CSS file, then add the new one. See https://github.com/tom-ricci/kumo-shadcn#themes",
  "type": "registry:theme"
}