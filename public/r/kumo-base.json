{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "kumo-base",
  "title": "Kumo base styles",
  "description": "Kumo's keyframes, helper classes and Tailwind token registration (from @cloudflare/kumo@2.19.1), all under kumo- names. Every Kumo component installs it. Add a theme item too.",
  "cssVars": {
    "theme": {
      "--ease-kumo-bounce": "cubic-bezier(0.2, 0, 0, 1.5)",
      "--animate-kumo-refresh": "kumo-refresh 0.5s ease-in-out infinite",
      "--animate-kumo-right": "kumo-right 15s linear infinite",
      "--color-kumo-arrow-edge": "var(--kumo-arrow-edge)",
      "--color-kumo-arrow-stroke": "var(--kumo-arrow-stroke)",
      "--color-kumo-badge-blue": "var(--kumo-badge-blue)",
      "--color-kumo-badge-green": "var(--kumo-badge-green)",
      "--color-kumo-badge-inverted": "var(--kumo-badge-inverted)",
      "--color-kumo-badge-neutral": "var(--kumo-badge-neutral)",
      "--color-kumo-badge-orange": "var(--kumo-badge-orange)",
      "--color-kumo-badge-purple": "var(--kumo-badge-purple)",
      "--color-kumo-badge-red": "var(--kumo-badge-red)",
      "--color-kumo-badge-secondary": "var(--kumo-badge-secondary)",
      "--color-kumo-badge-teal": "var(--kumo-badge-teal)",
      "--color-kumo-banner-info": "var(--kumo-banner-info)",
      "--color-kumo-banner-warning": "var(--kumo-banner-warning)",
      "--color-kumo-base": "var(--kumo-base)",
      "--color-kumo-brand": "var(--kumo-brand)",
      "--color-kumo-brand-hover": "var(--kumo-brand-hover)",
      "--color-kumo-canvas": "var(--kumo-canvas)",
      "--color-kumo-contrast": "var(--kumo-contrast)",
      "--color-kumo-control": "var(--kumo-control)",
      "--color-kumo-danger": "var(--kumo-danger)",
      "--color-kumo-danger-tint": "var(--kumo-danger-tint)",
      "--color-kumo-elevated": "var(--kumo-elevated)",
      "--color-kumo-fill": "var(--kumo-fill)",
      "--color-kumo-fill-hover": "var(--kumo-fill-hover)",
      "--color-kumo-focus": "var(--kumo-focus)",
      "--color-kumo-hairline": "var(--kumo-hairline)",
      "--color-kumo-info": "var(--kumo-info)",
      "--color-kumo-info-tint": "var(--kumo-info-tint)",
      "--color-kumo-interact": "var(--kumo-interact)",
      "--color-kumo-line": "var(--kumo-line)",
      "--color-kumo-overlay": "var(--kumo-overlay)",
      "--color-kumo-recessed": "var(--kumo-recessed)",
      "--color-kumo-shadow-drop": "var(--kumo-shadow-drop)",
      "--color-kumo-shadow-edge": "var(--kumo-shadow-edge)",
      "--color-kumo-success": "var(--kumo-success)",
      "--color-kumo-success-tint": "var(--kumo-success-tint)",
      "--color-kumo-tint": "var(--kumo-tint)",
      "--color-kumo-warning": "var(--kumo-warning)",
      "--color-kumo-warning-tint": "var(--kumo-warning-tint)",
      "--text-color-kumo-badge-inverted": "var(--kumo-text-badge-inverted)",
      "--text-color-kumo-badge-neutral-subtle": "var(--kumo-text-badge-neutral-subtle)",
      "--text-color-kumo-badge-orange-subtle": "var(--kumo-text-badge-orange-subtle)",
      "--text-color-kumo-badge-teal-subtle": "var(--kumo-text-badge-teal-subtle)",
      "--text-color-kumo-brand": "var(--kumo-text-brand)",
      "--text-color-kumo-danger": "var(--kumo-text-danger)",
      "--text-color-kumo-default": "var(--kumo-text-default)",
      "--text-color-kumo-inactive": "var(--kumo-text-inactive)",
      "--text-color-kumo-info": "var(--kumo-text-info)",
      "--text-color-kumo-inverse": "var(--kumo-text-inverse)",
      "--text-color-kumo-link": "var(--kumo-text-link)",
      "--text-color-kumo-placeholder": "var(--kumo-text-placeholder)",
      "--text-color-kumo-strong": "var(--kumo-text-strong)",
      "--text-color-kumo-subtle": "var(--kumo-text-subtle)",
      "--text-color-kumo-success": "var(--kumo-text-success)",
      "--text-color-kumo-warning": "var(--kumo-text-warning)"
    }
  },
  "css": {
    "@layer base": {
      ":root": {
        "color-scheme": "light",
        "--color-kumo-red-650": "oklch(55% 0.238 27.4)",
        "--color-kumo-red-750": "oklch(46% 0.195 27.2)",
        "--color-kumo-orange-650": "oklch(81.5% 0.197 76)",
        "--color-kumo-teal-650": "oklch(54.9% 0.096 184.565)",
        "--color-kumo-neutral-50": "oklch(98.75% 0 0)",
        "--color-kumo-neutral-75": "oklch(98% 0 0)",
        "--color-kumo-neutral-125": "oklch(96.5% 0 0)",
        "--color-kumo-neutral-450": "oklch(89% 0 0)",
        "--color-kumo-neutral-750": "oklch(32% 0 0)",
        "--color-kumo-neutral-850": "oklch(24% 0 0)",
        "--color-kumo-neutral-925": "oklch(17% 0 0)",
        "--color-kumo-neutral-950": "oklch(15% 0 0)",
        "--color-kumo-neutral-975": "oklch(12% 0 0)",
        "--color-kumo-neutral-1000": "oklch(10% 0 0)",
        "--kumo-transition-duration": "100ms"
      },
      "[data-mode=\"dark\"], .dark": {
        "color-scheme": "dark"
      },
      "@keyframes kumo-right": {
        "to": {
          "transform": "translateX(100%)"
        }
      },
      "@keyframes kumo-float": {
        "to": {
          "transform": "translate(5px, 15px)"
        }
      },
      "@keyframes kumo-refresh": {
        "from": {
          "transform": "rotate(0deg)"
        },
        "to": {
          "transform": "rotate(360deg)"
        }
      },
      "@keyframes kumo-bounce-in": {
        "0%": {
          "transform": "scale(0.6)",
          "opacity": "0"
        },
        "50%": {
          "transform": "scale(1.2)",
          "opacity": "1"
        },
        "100%": {
          "transform": "scale(1)"
        }
      },
      "@keyframes kumo-shimmer": {
        "0%": {
          "transform": "translateX(-100%)"
        },
        "100%": {
          "transform": "translateX(100%)"
        }
      },
      "@keyframes kumo-toast-bump": {
        "0%": {
          "transform": "scale(1)"
        },
        "20%": {
          "transform": "scale(1.02)"
        },
        "100%": {
          "transform": "scale(1)"
        }
      },
      "@keyframes kumo-toast-bump-alternate": {
        "0%": {
          "transform": "scale(1)"
        },
        "20%": {
          "transform": "scale(1.02)"
        },
        "100%": {
          "transform": "scale(1)"
        }
      },
      "@keyframes kumo-clipboard-toast-bump": {
        "0%": {
          "transform": "scale(1)"
        },
        "35%": {
          "transform": "scale(1.04)"
        },
        "100%": {
          "transform": "scale(1)"
        }
      },
      ".kumo-skeleton-line": {
        "position": "relative",
        "overflow": "hidden",
        "border-radius": "2px",
        "height": "0.5rem",
        "width": "var(--skeleton-width)",
        "background-color": "#f3f4f6"
      },
      ".kumo-skeleton-line::after": {
        "position": "absolute",
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0",
        "animation": "kumo-shimmer var(--shimmer-duration, 1.5s) var(--shimmer-delay, 0s)\n      infinite ease-in-out",
        "content": "\"\"",
        "background": "linear-gradient(\n      90deg,\n      rgba(0, 0, 0, 0) 0%,\n      rgba(0, 0, 0, 0.08) 50%,\n      rgba(0, 0, 0, 0) 100%\n    )"
      },
      "[data-mode=\"dark\"] .kumo-skeleton-line, .dark .kumo-skeleton-line": {
        "background-color": "rgba(255, 255, 255, 0.06)"
      },
      "[data-mode=\"dark\"] .kumo-skeleton-line::after, .dark .kumo-skeleton-line::after": {
        "background": "linear-gradient(\n      90deg,\n      rgba(255, 255, 255, 0) 0%,\n      rgba(255, 255, 255, 0.05) 50%,\n      rgba(255, 255, 255, 0) 100%\n    )"
      },
      "@keyframes kumo-scroll-fade-x-left": {
        "from": {
          "--kumo-fade-left-n": "0"
        },
        "to": {
          "--kumo-fade-left-n": "1"
        }
      },
      "@keyframes kumo-scroll-fade-x-right": {
        "from": {
          "--kumo-fade-right-n": "1"
        },
        "to": {
          "--kumo-fade-right-n": "0"
        }
      },
      "@keyframes kumo-rdp-slide_in_left": {
        "from": {
          "transform": "translateX(-100%)"
        },
        "to": {
          "transform": "translateX(0)"
        }
      },
      "@keyframes kumo-rdp-slide_in_right": {
        "from": {
          "transform": "translateX(100%)"
        },
        "to": {
          "transform": "translateX(0)"
        }
      },
      "@keyframes kumo-rdp-slide_out_left": {
        "from": {
          "transform": "translateX(0)"
        },
        "to": {
          "transform": "translateX(-100%)"
        }
      },
      "@keyframes kumo-rdp-slide_out_right": {
        "from": {
          "transform": "translateX(0)"
        },
        "to": {
          "transform": "translateX(100%)"
        }
      },
      "@keyframes kumo-rdp-fade_in": {
        "from": {
          "opacity": "0"
        },
        "to": {
          "opacity": "1"
        }
      },
      "@keyframes kumo-rdp-fade_out": {
        "from": {
          "opacity": "1"
        },
        "to": {
          "opacity": "0"
        }
      },
      "@keyframes kumo-skeleton": {
        "0%": {
          "background-position": "200% 0"
        },
        "100%": {
          "background-position": "-200% 0"
        }
      },
      ":root, .dark, [data-mode], [data-theme]": {
        "--color-kumo-arrow-edge": "var(--kumo-arrow-edge)",
        "--color-kumo-arrow-stroke": "var(--kumo-arrow-stroke)",
        "--color-kumo-badge-blue": "var(--kumo-badge-blue)",
        "--color-kumo-badge-green": "var(--kumo-badge-green)",
        "--color-kumo-badge-inverted": "var(--kumo-badge-inverted)",
        "--color-kumo-badge-neutral": "var(--kumo-badge-neutral)",
        "--color-kumo-badge-orange": "var(--kumo-badge-orange)",
        "--color-kumo-badge-purple": "var(--kumo-badge-purple)",
        "--color-kumo-badge-red": "var(--kumo-badge-red)",
        "--color-kumo-badge-secondary": "var(--kumo-badge-secondary)",
        "--color-kumo-badge-teal": "var(--kumo-badge-teal)",
        "--color-kumo-banner-info": "var(--kumo-banner-info)",
        "--color-kumo-banner-warning": "var(--kumo-banner-warning)",
        "--color-kumo-base": "var(--kumo-base)",
        "--color-kumo-brand": "var(--kumo-brand)",
        "--color-kumo-brand-hover": "var(--kumo-brand-hover)",
        "--color-kumo-canvas": "var(--kumo-canvas)",
        "--color-kumo-contrast": "var(--kumo-contrast)",
        "--color-kumo-control": "var(--kumo-control)",
        "--color-kumo-danger": "var(--kumo-danger)",
        "--color-kumo-danger-tint": "var(--kumo-danger-tint)",
        "--color-kumo-elevated": "var(--kumo-elevated)",
        "--color-kumo-fill": "var(--kumo-fill)",
        "--color-kumo-fill-hover": "var(--kumo-fill-hover)",
        "--color-kumo-focus": "var(--kumo-focus)",
        "--color-kumo-hairline": "var(--kumo-hairline)",
        "--color-kumo-info": "var(--kumo-info)",
        "--color-kumo-info-tint": "var(--kumo-info-tint)",
        "--color-kumo-interact": "var(--kumo-interact)",
        "--color-kumo-line": "var(--kumo-line)",
        "--color-kumo-overlay": "var(--kumo-overlay)",
        "--color-kumo-recessed": "var(--kumo-recessed)",
        "--color-kumo-shadow-drop": "var(--kumo-shadow-drop)",
        "--color-kumo-shadow-edge": "var(--kumo-shadow-edge)",
        "--color-kumo-success": "var(--kumo-success)",
        "--color-kumo-success-tint": "var(--kumo-success-tint)",
        "--color-kumo-tint": "var(--kumo-tint)",
        "--color-kumo-warning": "var(--kumo-warning)",
        "--color-kumo-warning-tint": "var(--kumo-warning-tint)",
        "--text-color-kumo-badge-inverted": "var(--kumo-text-badge-inverted)",
        "--text-color-kumo-badge-neutral-subtle": "var(--kumo-text-badge-neutral-subtle)",
        "--text-color-kumo-badge-orange-subtle": "var(--kumo-text-badge-orange-subtle)",
        "--text-color-kumo-badge-teal-subtle": "var(--kumo-text-badge-teal-subtle)",
        "--text-color-kumo-brand": "var(--kumo-text-brand)",
        "--text-color-kumo-danger": "var(--kumo-text-danger)",
        "--text-color-kumo-default": "var(--kumo-text-default)",
        "--text-color-kumo-inactive": "var(--kumo-text-inactive)",
        "--text-color-kumo-info": "var(--kumo-text-info)",
        "--text-color-kumo-inverse": "var(--kumo-text-inverse)",
        "--text-color-kumo-link": "var(--kumo-text-link)",
        "--text-color-kumo-placeholder": "var(--kumo-text-placeholder)",
        "--text-color-kumo-strong": "var(--kumo-text-strong)",
        "--text-color-kumo-subtle": "var(--kumo-text-subtle)",
        "--text-color-kumo-success": "var(--kumo-text-success)",
        "--text-color-kumo-warning": "var(--kumo-text-warning)"
      }
    },
    "@layer utilities": {
      ".kumo-no-scrollbar::-webkit-scrollbar": {
        "display": "none"
      },
      ".kumo-no-scrollbar": {
        "-ms-overflow-style": "none",
        "scrollbar-width": "none"
      },
      ".kumo-no-input-spinner": {
        "appearance": "textfield"
      },
      ".kumo-no-input-spinner ::-webkit-outer-spin-button, .kumo-no-input-spinner ::-webkit-inner-spin-button": {
        "appearance": "none"
      },
      ".kumo-link-current": {
        "text-decoration-color": "color-mix(in oklch, currentColor 35%, transparent)"
      },
      "[data-mode=\"dark\"] .kumo-link-current, .dark .kumo-link-current": {
        "text-decoration-color": "color-mix(in oklch, currentColor 65%, transparent)"
      },
      ".kumo-link-current:hover": {
        "text-decoration-color": "currentColor"
      },
      ".kumo-link-external-icon": {
        "stroke-width": "1.75"
      },
      "[data-mode=\"dark\"] .kumo-link-external-icon, .dark .kumo-link-external-icon": {
        "stroke-width": "2"
      }
    },
    ".kumo-float": {
      "animation": "kumo-float 5s linear infinite alternate"
    },
    ".animate-kumo-bounce-in": {
      "animation": "kumo-bounce-in 0.4s ease-out"
    },
    ".kumo-chart-shimmer": {
      "animation": "kumo-shimmer 1.8s ease-in-out infinite",
      "transform-box": "fill-box"
    },
    "@media (prefers-reduced-motion: reduce)": {
      ".kumo-chart-shimmer": {
        "animation": "none",
        "transform": "none"
      },
      ".animate-kumo-toast-bump, .animate-kumo-toast-bump-alternate": {
        "animation": "none"
      },
      ".animate-kumo-clipboard-toast-bump": {
        "animation": "none"
      },
      ".kumo-rdp-root": {
        "--kumo-rdp-animation_duration": "0.01ms"
      }
    },
    ".animate-kumo-toast-bump": {
      "animation": "kumo-toast-bump 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)",
      "transform-origin": "center"
    },
    ".animate-kumo-toast-bump-alternate": {
      "animation": "kumo-toast-bump-alternate 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)",
      "transform-origin": "center"
    },
    ".animate-kumo-clipboard-toast-bump": {
      "animation": "kumo-clipboard-toast-bump 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)",
      "transform-origin": "center"
    },
    "@property --kumo-fade-left-n": {
      "syntax": "\"<number>\"",
      "inherits": "false",
      "initial-value": "0"
    },
    "@property --kumo-fade-right-n": {
      "syntax": "\"<number>\"",
      "inherits": "false",
      "initial-value": "0"
    },
    "@supports (animation-timeline: scroll())": {
      "[data-kumo-overflowing]": {
        "mask-image": "linear-gradient(\n      var(--scroll-fade-direction, to right),\n      transparent,\n      white calc(var(--kumo-fade-left-n) * var(--scroll-fade-width, 3rem)),\n      white calc(100% - var(--kumo-fade-right-n) * var(--scroll-fade-width, 3rem)),\n      transparent\n    )",
        "animation-name": "kumo-scroll-fade-x-left, kumo-scroll-fade-x-right",
        "animation-timing-function": "linear, linear",
        "animation-timeline": "scroll(self x)",
        "animation-range": "0 var(--scroll-fade-range, 3rem),\n      calc(100% - var(--scroll-fade-range, 3rem)) 100%",
        "animation-fill-mode": "both"
      },
      ".kumo-tabs-list": {
        "scrollbar-width": "none",
        "-ms-overflow-style": "none"
      },
      ".kumo-tabs-list::-webkit-scrollbar": {
        "display": "none"
      }
    },
    ".kumo-tabs-list": {
      "overscroll-behavior-x": "contain"
    },
    "[data-mode=\"dark\"] .kumo-tooltip-popup, [data-mode=\"dark\"] .kumo-popover-popup, .dark .kumo-tooltip-popup, .dark .kumo-popover-popup": {
      "outline-offset": "-1px"
    },
    ".kumo-input-placeholder::placeholder": {
      "color": "var(--text-color-kumo-placeholder)"
    },
    ".kumo-rdp-root": {
      "--kumo-rdp-animation_duration": "0.2s",
      "--kumo-rdp-animation_timing": "ease-out"
    },
    ".kumo-rdp-weeks_before_enter": {
      "animation": "kumo-rdp-slide_in_left var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-weeks_before_exit": {
      "animation": "kumo-rdp-slide_out_left var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-weeks_after_enter": {
      "animation": "kumo-rdp-slide_in_right var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-weeks_after_exit": {
      "animation": "kumo-rdp-slide_out_right var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-root[dir=\"rtl\"] .kumo-rdp-weeks_after_enter": {
      "animation": "kumo-rdp-slide_in_left var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-root[dir=\"rtl\"] .kumo-rdp-weeks_before_exit": {
      "animation": "kumo-rdp-slide_out_right var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-root[dir=\"rtl\"] .kumo-rdp-weeks_before_enter": {
      "animation": "kumo-rdp-slide_in_right var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-root[dir=\"rtl\"] .kumo-rdp-weeks_after_exit": {
      "animation": "kumo-rdp-slide_out_left var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-caption_after_enter": {
      "animation": "kumo-rdp-fade_in var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-caption_after_exit": {
      "animation": "kumo-rdp-fade_out var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-caption_before_enter": {
      "animation": "kumo-rdp-fade_in var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ".kumo-rdp-caption_before_exit": {
      "animation": "kumo-rdp-fade_out var(--kumo-rdp-animation_duration)\n    var(--kumo-rdp-animation_timing) forwards"
    },
    ":where( a[href], button, input[type=\"button\"], input[type=\"checkbox\"], input[type=\"radio\"], input[type=\"submit\"], input[type=\"reset\"], label[for], select, summary, [role=\"button\"], [role=\"link\"], [role=\"menuitem\"], [role=\"menuitemcheckbox\"], [role=\"menuitemradio\"], [role=\"option\"], [role=\"tab\"], [role=\"checkbox\"], [role=\"radio\"], [role=\"switch\"] ):where([data-kumo-component], [data-kumo-part]):where(:not(:disabled)):where( :not([disabled]) ):where(:not([aria-disabled=\"true\"])):where(:not([data-disabled]))": {
      "cursor": "pointer"
    },
    ".kumo-skeleton": {
      "background": "linear-gradient(\n    90deg,\n    transparent 0%,\n    rgba(0, 0, 0, 0.05) 50%,\n    transparent 100%\n  )",
      "background-size": "200% 100%",
      "animation": "kumo-skeleton 1.5s ease-in-out infinite"
    },
    "[data-mode=\"dark\"] .kumo-skeleton, .dark .kumo-skeleton": {
      "background": "linear-gradient(\n    90deg,\n    transparent 0%,\n    rgba(255, 255, 255, 0.05) 50%,\n    transparent 100%\n  )"
