{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "kumo-cloudflare",
  "title": "Kumo theme, Cloudflare dashboard variant",
  "description": "Kumo's own colors with the Cloudflare dashboard's sidebar (canvas background; recessed, or control in dark mode, for the active item). Install one theme item: kumo-theme, kumo-cloudflare or kumo-binding. From @cloudflare/kumo@2.19.0.",
  "registryDependencies": [
    "https://raw.githubusercontent.com/tom-ricci/kumo-shadcn/main/public/r/kumo-base.json"
  ],
  "cssVars": {
    "theme": {
      "--text-xs": "12px",
      "--text-xs--line-height": "calc(1 / 0.75)",
      "--text-sm": "13px",
      "--text-sm--line-height": "calc(1 / 0.85)",
      "--text-base": "14px",
      "--text-base--line-height": "1.5",
      "--text-lg": "16px",
      "--text-lg--line-height": "1.5"
    }
  },
  "css": {
