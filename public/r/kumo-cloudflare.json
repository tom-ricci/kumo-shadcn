      "[data-theme=\"fedramp\"]": {
        "--kumo-canvas": "#5b697c",
        "--kumo-base": "#5b697c",
        "--kumo-hairline": "#c8d4e5"
      },
      "[data-mode=\"dark\"] [data-theme=\"fedramp\"], [data-theme=\"fedramp\"][data-mode=\"dark\"], [data-theme=\"fedramp\"] [data-mode=\"dark\"], .dark [data-theme=\"fedramp\"], [data-theme=\"fedramp\"].dark, [data-theme=\"fedramp\"] .dark": {
