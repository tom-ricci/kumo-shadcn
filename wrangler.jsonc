// Cloudflare Worker that serves public/ as static assets: the registry under
// /r/ and the docs page at /. No Worker script: public/_headers sets CORS and
// caching. Deployed by .github/workflows/update.yml.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kumo-shadcn",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "kumo-shadcn.thomasricci.dev",
      "custom_domain": true
    }
  ]
}
