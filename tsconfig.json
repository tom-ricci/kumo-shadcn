{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@/components/ui/*": [
        "./registry/kumo/ui/*"
      ],
      "@/components/*": [
        "./registry/kumo/blocks/*"
      ],
      "@/lib/kumo/*": [
        "./registry/kumo/lib/kumo/*"
      ],
      "@/app/(create)/components/icon-placeholder": [
        "./registry/icon-placeholder.tsx"
      ]
    },
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true
  },
  "include": [
    "registry/**/*.ts",
    "registry/**/*.tsx"
  ]
}
